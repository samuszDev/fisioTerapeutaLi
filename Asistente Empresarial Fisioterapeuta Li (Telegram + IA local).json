    {
      "parameters": {
        "jsCode": "const body = $json.body || {};\nconst requeridos = ['nombre', 'email', 'telefono', 'servicio', 'inicio', 'fin'];\nconst faltantes = requeridos.filter(c => body[c] === undefined || body[c] === null || String(body[c]).trim() === '');\nlet valido = true;\nlet motivo = '';\nif (faltantes.length > 0) {\n  valido = false;\n  motivo = 'Faltan campos obligatorios: ' + faltantes.join(', ') + '.';\n} else {\n  const inicio = new Date(body.inicio);\n  const fin = new Date(body.fin);\n  if (isNaN(inicio.getTime()) || isNaN(fin.getTime())) {\n    valido = false;\n    motivo = 'La fecha de inicio o de fin no tiene un formato válido (usa ISO 8601).';\n  } else if (inicio.getTime() <= Date.now()) {\n    valido = false;\n    motivo = 'El horario solicitado ya pasó. Elige una fecha y hora futuras.';\n  } else if (fin.getTime() <= inicio.getTime()) {\n    valido = false;\n    motivo = 'La hora de fin debe ser posterior a la hora de inicio.';\n  }\n}\nreturn [{ json: { valido, motivo, ...body } }];"
      },
